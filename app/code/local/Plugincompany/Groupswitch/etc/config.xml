<config>
    <modules>
        <Plugincompany_Groupswitch>
            <version>1.12.1</version>
        </Plugincompany_Groupswitch>
    </modules>
    <global>
        <helpers>
            <groupswitch>
                <class>Plugincompany_Groupswitch_Helper</class>
            </groupswitch>
        </helpers>
        <blocks>
            <groupswitch>
                <class>Plugincompany_Groupswitch_Block</class>
            </groupswitch>
        </blocks>
        <models>
            <groupswitch>
                <class>Plugincompany_Groupswitch_Model</class>
                <resourceModel>groupswitch_mysql4</resourceModel>
            </groupswitch>
            <groupswitch_mysql4>
                <class>Plugincompany_Groupswitch_Model_Mysql4</class>
                <entities>
                    <rule>
                        <table>plugincompany_groupswitch</table>
                    </rule>
                </entities>
            </groupswitch_mysql4>
        </models>
        <resources>
            <groupswitch_setup>
                <setup>
                    <module>Plugincompany_Groupswitch</module>
                </setup>
                <connection>
                    <use>core_setup</use>
                </connection>
            </groupswitch_setup>
            <groupswitch_write>
                <connection>
                    <use>core_write</use>
                </connection>
            </groupswitch_write>
            <groupswitch_read>
                <connection>
                    <use>core_read</use>
                </connection>
            </groupswitch_read>
        </resources>
        <events>
            <sales_order_invoice_save_after>
                <observers>
                    <groupswitch>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>salesOrderInvoiceSaveAfter</method>
                    </groupswitch>
                </observers>
            </sales_order_invoice_save_after>
            <sales_order_save_after>
                <observers>
                    <apply_customer_group_rules_transaction>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>salesOrderSaveAfter</method>
                    </apply_customer_group_rules_transaction>
                </observers>
            </sales_order_save_after>
            <customer_save_before>
                <observers>
                    <apply_customer_group_rules>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>customerSaveBefore</method>
                    </apply_customer_group_rules>
                </observers>
            </customer_save_before>
            <customer_save_after>
                <observers>
                    <apply_customer_group_rules_after>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>customerSaveAfter</method>
                    </apply_customer_group_rules_after>
                </observers>
            </customer_save_after>
            <customer_address_save_after>
                <observers>
                    <groupswitch>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>customerAddressSaveAfter</method>
                    </groupswitch>
                </observers>
            </customer_address_save_after>
            <model_save_commit_after>
                <observers>
                    <groupswitch>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>modelSaveCommitAfter</method>
                    </groupswitch>
                </observers>
            </model_save_commit_after>
            <customer_login>
                <observers>
                    <groupswitch>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>customerLogin</method>
                    </groupswitch>
                </observers>
            </customer_login>
            <newsletter_subscriber_save_after>
                <observers>
                    <groupswitch>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>newsletterSubscriberSaveAfter</method>
                    </groupswitch>
                </observers>
            </newsletter_subscriber_save_after>
            <sales_order_save_before>
                <observers>
                    <sales_order_save_before>
                        <type>model</type>
                        <class>groupswitch/observer</class>
                        <method>salesOrderSaveBefore</method>
                    </sales_order_save_before>
                </observers>
            </sales_order_save_before>
        </events>
    </global>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <groupswitch before="Mage_Adminhtml">Plugincompany_Groupswitch</groupswitch>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <adminhtml>
        <menu>
            <customer>
                <children>
                    <groupswitch module="groupswitch">
                        <title>Automatic Customer Group Switching</title>
                        <sort_order>10000</sort_order>
                        <action>adminhtml/adminhtml_groupswitch</action>
                    </groupswitch>
                </children>
            </customer>
        </menu>
        <acl>
            <resources>
                <all>
                    <title>Allow Everything</title>
                </all>
                <admin>
                    <children>
                        <customer>
                            <children>
                                <groupswitch translate="title" module="groupswitch">
                                    <title>Automatic Customer Group Switching</title>
                                    <sort_order>1000</sort_order>
                                </groupswitch>
                            </children>
                        </customer>
                        <system>
                            <children>
                                <config>
                                    <children>
                                        <groupswitch>
                                            <title>Automatic Customer Group Switching</title>
                                        </groupswitch>
                                    </children>
                                </config>
                            </children>
                        </system>
                    </children>
                </admin>
            </resources>
        </acl>
        <translate>
            <modules>
                <Plugincompany_Contactforms>
                    <files>
                        <default>Plugincompany_Groupswitch.csv</default>
                    </files>
                </Plugincompany_Contactforms>
            </modules>
        </translate>
        <layout>
            <updates>
                <groupswitch>
                    <file>groupswitch.xml</file>
                </groupswitch>
            </updates>
        </layout>
    </adminhtml>
    <crontab>
        <jobs>
            <plugincompany_bulk_customer_group_switch>
                <schedule>
                    <config_path>groupswitch/cronjob/cron_settings</config_path>
                </schedule>
                <run>
                    <model>groupswitch/observer::bulkCustomerGroupSwitchCron</model>
                </run>
            </plugincompany_bulk_customer_group_switch>
        </jobs>
    </crontab>
    <default>
        <groupswitch>
            <cronjob>
                <cron_settings>*/5 1-3 * * *</cron_settings>
                <max_customer>1000</max_customer>
                <only_once>1</only_once>
            </cronjob>
        </groupswitch>
    </default>
</config>