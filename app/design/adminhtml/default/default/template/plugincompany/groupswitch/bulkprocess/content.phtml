                    <th>From Group</th>
                    <th>To Group</th>
                    <th style="width:150px;">Date / Time</th>
                </tr>
                </thead>
                <tbody id="results">
                </tbody>
            </table>
        </div>
    <?php } ?>
</div>

<?php if($totalCustomers) { ?>
    <script type="text/javascript">
        var processed = 0;
        var totalCustomers = <?php echo $totalCustomers; ?>;
        function executeBatch(offset){
            var offset = offset;
            new Ajax.Request("<?php echo $this->getUrl('*/*/applyRulesBulk'); ?>", {
                method: 'POST',
                parameters: {
                    offset:offset,
                    'ruleIds[]': <?php echo json_encode($this->getRuleIds()); ?>
                },
                onComplete: function(transport) {
                    var result = transport.responseJSON;

                    //if no results, stop
                    if(result == "done"){
                        console.log('done');
                        return;
                    }

                    addRows(result);

                    //update progress
                    updateProgress(10);

                    //execute next batch based on last customer ID
                    var lastCustomerId = result[result.length - 1]['customer_id'];
                    executeBatch(lastCustomerId);
                }
            });
        }
        function addRows(result)
        {
            $PC.each(result,function(k,v){
                var html = '<tr>';
                html += '<td>' + v.customer_id + '</td>';
                html += '<td>' + v.customer_name + '</td>';
                html += '<td>' + v.from_group + '</td>';
                html += '<td>' + v.to_group + '</td>';
                html += '<td>' + v.date + '</td>';
                html += '</tr>';
                $PC(html).prependTo('#results');
            });
        }
        function updateProgress(count){
            processed = processed + count;
            if(processed > totalCustomers){
                processed = totalCustomers;
            }
            var percent = ((processed / totalCustomers) * 100).toFixed(2);
            $PC('#customers_processed').text(processed);
            $PC('#percent').text(percent);
        }

        $PC(document).ready(function(){
            executeBatch(0);
        })
    </script>
<?php } ?>

